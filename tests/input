#------------------------------------------
# Creation attributes:
#------------------------------------------
create:full
create:periodic-boundaries-x
create:periodic-boundaries-y
create:periodic-boundaries-z
#------------------------------------------
material:file=vampire.mat
material:unit-cell-file = "vampire.UCF"
#------------------------------------------
# System Dimensions:
#------------------------------------------
dimensions:unit-cell-size-x = 4.0541126372875915 !A
dimensions:unit-cell-size-y = 4.0541126372875915 !A
dimensions:unit-cell-size-z = 4.0541126372875915 !A
dimensions:system-size-x = 6.891991483388906 !nm
dimensions:system-size-y = 6.891991483388906 !nm
dimensions:system-size-z = 6.891991483388906 !nm
#------------------------------------------
# Exchange parameter:
#------------------------------------------
#exchange:ab-initio = true
#------------------------------------------
# Simulation attributes:
#------------------------------------------
sim:minimum-temperature = 0
sim:maximum-temperature = 1800
sim:temperature-increment = 10
sim:equilibration-time-steps = 100
sim:loop-time-steps = 1000
sim:time-steps-increment = 1
#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:program=curie-temperature
sim:integrator = monte-carlo
#------------------------------------------
# Data output
#------------------------------------------
#output:real-time
output:temperature
#output:material-magnetisation
output:magnetisation-length
output:mean-total-energy
